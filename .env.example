# Scanify API Configuration
# Copy to .env and fill in your values

# REQUIRED in production — JWT signing key (min 32 chars)
SCANIFY_SECRET_KEY=

# REQUIRED for admin endpoints
SCANIFY_ADMIN_KEY=

# API server
SCANIFY_HOST=127.0.0.1
SCANIFY_PORT=8000
SCANIFY_DEBUG=false

# CORS — comma-separated list of allowed origins
# Leave empty to use built-in defaults (localhost + scanify.app)
SCANIFY_CORS_ORIGINS=

# Data providers — at least one required for live scanning
POLYGON_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional — additional data feed
DATA_API_KEY=
