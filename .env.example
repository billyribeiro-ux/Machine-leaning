# Scanify API Configuration
# Copy to .env and fill in your values

# REQUIRED in production — JWT signing key (min 32 chars)
SCANIFY_SECRET_KEY=

# REQUIRED for admin endpoints
SCANIFY_ADMIN_KEY=

# API server
SCANIFY_HOST=127.0.0.1
SCANIFY_PORT=8000
SCANIFY_DEBUG=false

# CORS — comma-separated list of allowed origins
# Leave empty to use built-in defaults (localhost + scanify.app)
SCANIFY_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# FMP (Financial Modeling Prep) — Primary equity data provider
# Sign up at: https://site.financialmodelingprep.com/developer/docs
# ---------------------------------------------------------------------------
SCANIFY_FMP_API_KEY=

# ---------------------------------------------------------------------------
# Charles Schwab — Options chain & market data (OAuth 2.0)
# Register at: https://developer.schwab.com/
# ---------------------------------------------------------------------------
SCANIFY_SCHWAB_CLIENT_ID=
SCANIFY_SCHWAB_CLIENT_SECRET=
SCANIFY_SCHWAB_REDIRECT_URI=https://127.0.0.1
SCANIFY_SCHWAB_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Legacy data providers (optional)
# ---------------------------------------------------------------------------
POLYGON_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
DATA_API_KEY=
